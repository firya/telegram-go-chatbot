# Конфигурация бота. Скопируйте в .env и заполните: cp .env.example .env && chmod 600 .env
#
# Приоритет: переменные окружения процесса > этот файл. Файл читается из рабочей
# директории бота; ZAVTRA_ENV_FILE указывает на другой путь.
# В Docker: docker run --env-file .env, в compose env_file: .env, в systemd EnvironmentFile=.
# Файл содержит токен бота и пароль базы — держите его приватным (в .gitignore).
#
# Старый config.json конвертируется одной командой:
#   ZAVTRA_IMPORT_CONFIG_JSON=config.json ./zavtrachat_bot > .env

# --- Обязательное ---
# Токен бота от @BotFather
ZAVTRA_TOKEN=
# ID основного чата (отрицательный, например -1001234567890)
ZAVTRA_CHAT=

# --- База данных ---
# PostgreSQL DSN
ZAVTRA_DSN=postgres://user:password@localhost:5432/zavtrachat

# --- Bot API ---
# Базовый URL Bot API (по умолчанию https://api.telegram.org; для self-hosted Bot API — свой)
ZAVTRA_BOT_API_URL=https://api.telegram.org
# datadir self-hosted Bot API: файлы читаются прямо с диска для /convert, /distort, /invert, /loop
ZAVTRA_BOT_API_DATADIR=

# Какие апдейты запрашивать (по умолчанию message,channel_post,callback_query,chat_member)
ZAVTRA_ALLOWED_UPDATES=

# --- MTProto (для /meow, /woof, /meme) ---
ZAVTRA_APP_ID=
ZAVTRA_APP_HASH=

# --- Чаты ---
# Чат, где удаляются сообщения о входе/выходе
ZAVTRA_RESERVE_CHAT=
# Канал, посты которого пересылаются в чат
ZAVTRA_CHANNEL=
# Куда дублируются пересланные посты
ZAVTRA_STREAM_CHANNEL=

# --- Модерация ---
# ID с правами модерации, списки через запятую
ZAVTRA_ADMINS=
ZAVTRA_MODERS=
# Получатель уведомлений о старте, ошибках и антиспаме: эфемерные сообщения
# в основном чате, видит только он (нужен self-hosted Bot API)
ZAVTRA_SYSADMIN=

# --- Вебхук (пусто = long polling) ---
ZAVTRA_LISTEN=
ZAVTRA_ENDPOINT_PUBLIC_URL=
ZAVTRA_MAX_CONNECTIONS=

# --- Внешние сервисы ---
# CoinMarketCap API key для /cur
ZAVTRA_CURRENCY_KEY=
# Календарь для /releases (по умолчанию PS/PS5/Switch/Xbox PAL)
ZAVTRA_RELEASES_URL=
# HTTP-прокси для исходящих запросов: /advice, /anekdot, /releases, скачивание файлов
ZAVTRA_PROXY=

# --- Антиспам ---
# Окно в секундах и порог сообщений
ZAVTRA_ANTISPAM_WINDOW=
ZAVTRA_ANTISPAM_COUNT=

# --- AI-модуль (ai_*.go, в main.go пока выключен) ---
ZAVTRA_AI_URL=
ZAVTRA_AI_TOKEN=
ZAVTRA_AI_MODEL=
ZAVTRA_AI_SYSTEM=
ZAVTRA_AI_ADMIN_ONLY_TOOLS=

# --- Объявлено в конфиге, в коде сейчас не используется ---
ZAVTRA_FONTPATH=
ZAVTRA_COMMENT_CHAT=
